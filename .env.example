# Environment variables for pshelf (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

MANUAL_API_URL=http://<hostname>:3004
IGDB_API_URL=http://<igdb-host>:8765
DATA_DIR=/path/to/catalog-data
HOMEPAGE_URL=http://<hostname>:3005/

# Public origin the browser uses to reach pshelf. MUST match exactly, including
# the scheme. SvelteKit (adapter-node) defaults the origin to https:// when no
# proxy protocol header is present, so on a plain-HTTP deployment the unset
# default makes the CSRF check reject every form POST (e.g. the /psn NPSSO
# paste) as cross-site. Set this to the same URL you type in the browser.
ORIGIN=http://<hostname>:3005
